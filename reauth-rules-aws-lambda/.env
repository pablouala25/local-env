# Configuración de red
APP_NETWORK=app-network

# DynamoDB Local
DYNAMODB_CONTAINER_NAME=dynamodb-local
DYNAMODB_PORT=8000
DYNAMODB_DATA_PATH=/home/dynamodblocal/data
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
DYNAMODB_TABLE_NAME=Rules

# DynamoDB Admin
DYNAMODB_ADMIN_CONTAINER_NAME=dynamodb-admin
DYNAMODB_ADMIN_PORT=8001

# Lambda Go Dev
LAMBDA_GO_DEV_CONTAINER_NAME=lambda-go-dev
LAMBDA_GO_DEV_PORT=9000
LAMBDA_GO_DEV_TARGET_PORT=9000

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy

# LocalStack
SERVICES=dynamodb
PERSISTENCE=1
LAMBDA_KEEPALIVE_MS=30000

# NP Dimensions
NP_DIMENSION_ENVIRONMENT=local
NP_DIMENSION_COUNTRY=US
NP_DIMENSION_REGION=us-east-1

# Rules Table
RULES_TABLE_NAME=Rules

# Feature Flags
CREATE_RULE_ENABLED=true
GET_RULES_ENABLED=true
UPDATE_RULE_ENABLED=true
DELETE_RULE_ENABLED=true

# Observability
METRICS_ENABLED=false
TRACING_ENABLED=false
